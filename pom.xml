<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ororura</groupId>
    <artifactId>slseleven</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>slseleven</name>

        <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <javafx.version>17.0.14</javafx.version>
        <main.class>com.ororura.slseleven/com.ororura.slseleven.HelloApplication</main.class>
        <app.name>Календарь занятий</app.name>
        <app.version>1.0.0</app.version>
        <app.vendor>SLSEleven</app.vendor>
        <app.identifier>com.ororura.slseleven</app.identifier>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.xerial/sqlite-jdbc -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.51.1.0</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.12.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.12.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

       <build>
        <plugins>
            <!-- Compiler plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

            <!-- JavaFX Maven plugin for jlink (creates runtime with JRE) -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <!-- Default configuration for running with: mvn clean javafx:run -->
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>${main.class}</mainClass>
                            <launcher>app</launcher>
                            <jlinkZipName>app</jlinkZipName>
                            <jlinkImageName>app</jlinkImageName>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Create runtime image with JRE for jpackage -->
                        <id>create-runtime-image</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jlink</goal>
                        </goals>
                        <configuration>
                            <mainClass>${main.class}</mainClass>
                            <launcher>calendar-app</launcher>
                            <jlinkImageName>calendar-runtime</jlinkImageName>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                            <compress>2</compress>
                            <!-- Включаем все необходимые модули -->
                            <addModules>com.ororura.slseleven,javafx.controls,javafx.fxml,javafx.base</addModules>
                            <!-- Включаем модули для SQLite JDBC (автоматические модули) -->
                            <options>
                                <option>--add-modules</option>
                                <option>java.sql,java.naming</option>
                                <option>--add-opens</option>
                                <option>java.base/java.lang=ALL-UNNAMED</option>
                                <option>--add-opens</option>
                                <option>java.base/java.util=ALL-UNNAMED</option>
                            </options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy SQLite JDBC to runtime image (after jlink creates it) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>copy-sqlite-jdbc</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.xerial</groupId>
                                    <artifactId>sqlite-jdbc</artifactId>
                                    <version>3.51.1.0</version>
                                    <outputDirectory>${project.build.directory}/calendar-runtime/lib</outputDirectory>
                                    <destFileName>sqlite-jdbc.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Plugin for creating DMG with embedded JRE using jpackage -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>create-dmg</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>jpackage</executable>
                            <arguments>
                                <!-- Тип пакета -->
                                <argument>--type</argument>
                                <argument>dmg</argument>

                                <!-- Runtime image с JRE (созданный через jlink) -->
                                <argument>--runtime-image</argument>
                                <argument>${project.build.directory}/calendar-runtime</argument>

                                <!-- Имя приложения -->
                                <argument>--name</argument>
                                <argument>${app.name}</argument>

                                <!-- Версия приложения -->
                                <argument>--app-version</argument>
                                <argument>${app.version}</argument>

                                <!-- Производитель -->
                                <argument>--vendor</argument>
                                <argument>${app.vendor}</argument>

                                <!-- Главный модуль и класс -->
                                <argument>--module</argument>
                                <argument>com.ororura.slseleven/com.ororura.slseleven.HelloApplication</argument>

                                <!-- macOS специфичные настройки -->
                                <argument>--mac-package-identifier</argument>
                                <argument>${app.identifier}</argument>
                                <argument>--mac-package-name</argument>
                                <argument>${app.name}</argument>

                                <!-- Опции JVM -->
                                <argument>--java-options</argument>
                                <argument>-Xmx512m</argument>
                                <argument>--java-options</argument>
                                <argument>-Dfile.encoding=UTF-8</argument>

                                <!-- Директория для выходного файла -->
                                <argument>--dest</argument>
                                <argument>${project.build.directory}/installer</argument>

                                <!-- Описание приложения -->
                                <argument>--description</argument>
                                <argument>Календарь занятий с возможностью добавления, редактирования и удаления занятий</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>