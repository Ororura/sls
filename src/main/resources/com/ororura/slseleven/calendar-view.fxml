<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.ororura.slseleven.adapters.controller.CalendarController"
    styleClass="app-root"
>
    <top>
        <VBox spacing="10" styleClass="top-section">
            <VBox spacing="10" styleClass="top-card">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10" />
                </padding>
                <FlowPane alignment="CENTER_LEFT" styleClass="top-bar">
                    <Button
                        fx:id="previousMonthButton"
                        text="◀ Предыдущий"
                        styleClass="button-ghost"
                    />
                    <Label fx:id="monthYearLabel" styleClass="title" />
                    <Button
                        fx:id="nextMonthButton"
                        text="Следующий ▶"
                        styleClass="button-ghost"
                    />
                    <Button
                        text="Текущий месяц"
                        onAction="#onCurrentMonth"
                        styleClass="button-secondary"
                    />
                    <Button
                        text="Печать A4 (PNG)"
                        onAction="#onExportPrintImage"
                        styleClass="button-secondary"
                    />
                    <Button
                        text="Печать A4 (Excel)"
                        onAction="#onExportPrintExcel"
                        styleClass="button-secondary"
                    />
                    <Button
                        text="Авторасписание"
                        styleClass="button-secondary"
                        onAction="#onOpenSchedulePlanner"
                    />
                    <Button
                        text="Все занятия"
                        styleClass="button-primary"
                        onAction="#onOpenLessonsList"
                    />
                    <Button
                        text="О приложении"
                        styleClass="button-ghost"
                        onAction="#onAboutApp"
                    />
                </FlowPane>

                <FlowPane alignment="CENTER_LEFT" styleClass="control-bar">
                    <Label text="Директория:" />
                    <ComboBox
                        fx:id="directoryComboBox"
                        prefWidth="170"
                        promptText="Все директории"
                        styleClass="directory-combo"
                    />
                    <Label text="Календарь:" />
                    <ComboBox
                        fx:id="calendarComboBox"
                        prefWidth="230"
                        promptText="Выберите календарь"
                        styleClass="calendar-combo"
                    />
                    <Button
                        text="Новый"
                        onAction="#onCreateCalendar"
                        styleClass="button-secondary"
                    />
                    <Button
                        text="Папка"
                        onAction="#onMoveCalendarToDirectory"
                        styleClass="button-secondary"
                    />
                    <Button
                        text="Переименовать"
                        onAction="#onRenameCalendar"
                        styleClass="button-secondary"
                    />
                    <Button
                        text="Удалить"
                        onAction="#onDeleteCalendar"
                        styleClass="button-danger"
                    />
                    <Label
                        text="ЛКМ: открыть день, ПКМ: добавить занятие"
                        styleClass="hint"
                    />
                </FlowPane>

                <FlowPane alignment="CENTER_LEFT" styleClass="status-bar">
                    <Label text="СЕЙЧАС" styleClass="status-title" />
                    <Label fx:id="currentDateLabel" styleClass="status-chip-date" text="Дата: -" />
                    <Label fx:id="currentTimeLabel" styleClass="status-chip-time" text="Время: -" />
                    <Label fx:id="currentLessonLabel" styleClass="status-lesson-none" text="Текущее занятие: -" />
                </FlowPane>
            </VBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="12" styleClass="content">
            <VBox spacing="10" styleClass="calendar-panel panel-card" HBox.hgrow="ALWAYS">
                <GridPane fx:id="calendarGrid" styleClass="calendar-grid" />
            </VBox>

            <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="sidebar"
                HBox.hgrow="ALWAYS"
            >
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
                <content>
                    <VBox fx:id="lessonsList" spacing="10" styleClass="sidebar-content">

                        <Label
                            text="Занятия на день"
                            styleClass="section-title"
                        />
                        <Label
                            text="Выберите дату слева, чтобы увидеть список занятий"
                            styleClass="muted"
                        />
                    </VBox>
                </content>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>
