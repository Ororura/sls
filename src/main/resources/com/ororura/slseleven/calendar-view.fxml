<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.ororura.slseleven.controller.CalendarController"
    styleClass="app-root"
>
    <top>
        <VBox spacing="10" styleClass="top-section">
            <HBox alignment="CENTER" spacing="20" styleClass="top-bar">
                <Button
                    fx:id="previousMonthButton"
                    text="◀ Предыдущий месяц"
                    styleClass="button-ghost"
                />
                <Label fx:id="monthYearLabel" styleClass="title" />
                <Button
                    fx:id="nextMonthButton"
                    text="Следующий месяц ▶"
                    styleClass="button-ghost"
                />
                <Pane HBox.hgrow="ALWAYS" />
                <Button
                    text="Авторасписание"
                    styleClass="button-secondary"
                    onAction="#onOpenSchedulePlanner"
                />
                <Button
                    text="Все занятия"
                    styleClass="button-primary"
                    onAction="#onOpenLessonsList"
                />
            </HBox>
            <Label
                text="Левый клик - выбрать дату, Правый клик - добавить занятие"
                styleClass="hint"
            />
        </VBox>
    </top>

    <center>
        <HBox spacing="20" styleClass="content">
            <VBox spacing="10" styleClass="calendar-panel">
                <GridPane fx:id="calendarGrid" styleClass="calendar-grid" />
            </VBox>

            <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="sidebar"
                HBox.hgrow="ALWAYS"
            >
                <content>
                    <VBox fx:id="lessonsList" spacing="10" styleClass="sidebar">
                        <Label text="Занятия" styleClass="section-title" />
                    </VBox>
                </content>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>
