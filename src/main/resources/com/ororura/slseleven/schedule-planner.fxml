<?xml version="1.0" encoding="UTF-8" ?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.ororura.slseleven.controller.SchedulePlannerController"
    styleClass="app-root"
>

    <top>
        <VBox styleClass="toolbar">
            <VBox spacing="10" styleClass="toolbar-card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Авторасписание" styleClass="title" />
                    <TextField
                        fx:id="searchField"
                        promptText="Поиск: предмет, тема, занятие, место, преподаватель"
                        HBox.hgrow="ALWAYS"
                        styleClass="search-field"
                    />
                    <Button
                        text="Добавить"
                        onAction="#onAddItem"
                        styleClass="button-primary"
                    />
                    <Button
                        text="Редактировать"
                        onAction="#onEditItem"
                        styleClass="button-secondary"
                    />
                </HBox>

                <FlowPane styleClass="action-flow">
                    <Button
                        text="Импорт"
                        onAction="#onImport"
                        styleClass="button-secondary"
                    />
                    <Button
                        text="Импорт XLSX"
                        onAction="#onImportXlsx"
                        styleClass="button-secondary"
                    />
                    <Button
                        text="Быстрый экспорт"
                        onAction="#onQuickExport"
                        styleClass="button-secondary"
                    />
                    <Button
                        text="Экспорт XLSX"
                        onAction="#onExportXlsx"
                        styleClass="button-secondary"
                    />
                    <Button
                        text="Удалить"
                        onAction="#onDeleteItem"
                        styleClass="button-danger"
                    />
                    <Button
                        text="Удалить все"
                        onAction="#onDeleteAll"
                        styleClass="button-danger"
                    />
                </FlowPane>
            </VBox>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content">
            <TableView fx:id="scheduleTable" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="topicColumn" text="Предмет" />
                    <TableColumn fx:id="lessonNameColumn" text="Тема" />
                    <TableColumn fx:id="classNameColumn" text="Занятие" />
                    <TableColumn fx:id="locationColumn" text="Место" />
                    <TableColumn fx:id="instructorColumn" text="Преподаватель" />
                    <TableColumn fx:id="hoursColumn" text="Часы" />
                    <TableColumn fx:id="consecutiveHoursColumn" text="Подряд (предмет)" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="10" styleClass="footer-bar footer-stack">
            <HBox spacing="12" styleClass="form-strip">
                <Label fx:id="totalHoursLabel" text="Всего часов: 0" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label text="Дата начала:" />
                <DatePicker fx:id="startDatePicker" />
                <Label text="Дата окончания:" />
                <DatePicker fx:id="endDatePicker" promptText="Не ограничивать" />
            </HBox>

            <GridPane hgap="12" vgap="8" styleClass="form-strip">
                <Label
                    text="Пн"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="0"
                />
                <Spinner
                    fx:id="mondayHours"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="1"
                />

                <Label
                    text="Вт"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="2"
                />
                <Spinner
                    fx:id="tuesdayHours"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="3"
                />

                <Label
                    text="Ср"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="4"
                />
                <Spinner
                    fx:id="wednesdayHours"
                    GridPane.rowIndex="0"
                    GridPane.columnIndex="5"
                />

                <Label
                    text="Чт"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="0"
                />
                <Spinner
                    fx:id="thursdayHours"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="1"
                />

                <Label
                    text="Пт"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="2"
                />
                <Spinner
                    fx:id="fridayHours"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="3"
                />

                <Label
                    text="Сб"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="4"
                />
                <Spinner
                    fx:id="saturdayHours"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="5"
                />

                <Label
                    text="Вс"
                    GridPane.rowIndex="2"
                    GridPane.columnIndex="0"
                />
                <Spinner
                    fx:id="sundayHours"
                    GridPane.rowIndex="2"
                    GridPane.columnIndex="1"
                />
            </GridPane>

            <FlowPane styleClass="action-flow">
                <Button
                    text="Сохранить настройки"
                    onAction="#onSaveSettings"
                    styleClass="button-secondary"
                />
                <Button
                    text="Архив в пул"
                    onAction="#onLoadArchiveToPool"
                    styleClass="button-secondary"
                />
                <Button
                    text="Правила предметов"
                    onAction="#onSubjectRules"
                    styleClass="button-secondary"
                />
                <Button
                    text="История"
                    onAction="#onHistory"
                    styleClass="button-secondary"
                />
                <Button
                    text="Сформировать расписание"
                    onAction="#onAutoSchedule"
                    styleClass="button-primary"
                />
                <Button
                    text="Перераспределить"
                    onAction="#onReschedule"
                    styleClass="button-secondary"
                />
            </FlowPane>
        </VBox>
    </bottom>

</BorderPane>
