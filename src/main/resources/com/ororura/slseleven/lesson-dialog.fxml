<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.ororura.slseleven.controller.LessonDialogController"
          hgap="10" vgap="10" style="-fx-padding: 20;" prefWidth="400">
    <columnConstraints>
        <ColumnConstraints minWidth="150" />
        <ColumnConstraints minWidth="200" hgrow="ALWAYS" />
    </columnConstraints>
    
    <Label text="Тема:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
    <TextField fx:id="topicField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

    <Label text="Занятие:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <TextField fx:id="lessonNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    
    <Label text="Время (HH:mm):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <TextField fx:id="timeField" GridPane.columnIndex="1" GridPane.rowIndex="2" 
               promptText="14:30" />
    
    <Label text="Расположение:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <TextField fx:id="locationField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    
    <Label text="Преподаватель:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <TextField fx:id="instructorField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    
    <Label text="Дата:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
    <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="5" />
</GridPane>
