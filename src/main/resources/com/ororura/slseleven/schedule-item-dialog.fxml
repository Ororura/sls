<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.ororura.slseleven.adapters.controller.ScheduleItemDialogController"
          prefWidth="420" styleClass="dialog-grid">
    <columnConstraints>
        <ColumnConstraints minWidth="150" />
        <ColumnConstraints minWidth="200" hgrow="ALWAYS" />
    </columnConstraints>

    <Label text="Предмет:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-label"/>
    <TextField fx:id="topicField" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="form-field"/>

    <Label text="Тема:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="form-label"/>
    <TextField fx:id="lessonNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="form-field"/>

    <Label text="Занятие:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="form-label"/>
    <TextField fx:id="classNameField" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="form-field"/>

    <Label text="Расположение (необязательно):" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="form-label"/>
    <TextField fx:id="locationField" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="form-field"/>

    <Label text="Преподаватель (необязательно):" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="form-label"/>
    <TextField fx:id="instructorField" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="form-field"/>

    <Label text="Часы всего:" GridPane.columnIndex="0" GridPane.rowIndex="5" styleClass="form-label"/>
    <TextField fx:id="hoursField" GridPane.columnIndex="1" GridPane.rowIndex="5" promptText="Например, 6" styleClass="form-field"/>

    <Label text="Часы подряд (для предмета):" GridPane.columnIndex="0" GridPane.rowIndex="6" styleClass="form-label"/>
    <TextField fx:id="consecutiveHoursField" GridPane.columnIndex="1" GridPane.rowIndex="6" promptText="Например, 2" styleClass="form-field"/>
</GridPane>
