<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ororura.slseleven.controller.LessonsListController">

    <!-- Верхняя панель -->
    <top>
        <ToolBar>
            <Label text="Все занятия"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Обновить" onAction="#onRefresh"/>
        </ToolBar>
    </top>

    <!-- Таблица занятий -->
    <center>
        <TableView fx:id="lessonTable">

            <columns>
                <TableColumn fx:id="dateColumn" text="Дата"/>
                <TableColumn fx:id="timeColumn" text="Время"/>
                <TableColumn fx:id="topicColumn" text="Тема"/>
                <TableColumn fx:id="lessonNameColumn" text="Занятие"/>
                <TableColumn fx:id="locationColumn" text="Место"/>
                <TableColumn fx:id="instructorColumn" text="Преподаватель"/>
            </columns>

        </TableView>
    </center>

    <!-- Нижняя панель -->
    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Label fx:id="countLabel" text="Всего занятий: 0"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Удалить" onAction="#onDelete"/>
        </HBox>
    </bottom>

</BorderPane>
