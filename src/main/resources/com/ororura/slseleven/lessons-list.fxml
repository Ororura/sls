<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="app-root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.ororura.slseleven.controller.LessonsListController">

    <top>
        <VBox styleClass="toolbar">
            <VBox spacing="10" styleClass="toolbar-card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="title" text="Все занятия" />
                    <TextField fx:id="searchField" promptText="Поиск: предмет, тема, занятие, место, преподаватель" styleClass="search-field" HBox.hgrow="ALWAYS" />
                    <Button onAction="#onRefresh" styleClass="button-ghost" text="Обновить" />
                    <Button onAction="#onShowArchive" styleClass="button-secondary" text="Архив" />
                </HBox>

                <FlowPane styleClass="action-flow">
                    <Button onAction="#onImport" styleClass="button-secondary" text="Импорт" />
                    <Button onAction="#onImportXlsx" styleClass="button-secondary" text="Импорт XLSX" />
                    <Button onAction="#onExport" styleClass="button-secondary" text="Экспорт" />
                    <Button onAction="#onWeeklyReport" styleClass="button-secondary" text="Отчет по неделям" />
                </FlowPane>
            </VBox>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content">
            <TableView fx:id="lessonTable" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Дата" />
                    <TableColumn fx:id="timeColumn" text="Время" />
                    <TableColumn fx:id="topicColumn" text="Предмет" />
                    <TableColumn fx:id="lessonNameColumn" text="Тема" />
                    <TableColumn fx:id="classNameColumn" text="Занятие" />
                    <TableColumn fx:id="locationColumn" text="Место" />
                    <TableColumn fx:id="instructorColumn" text="Преподаватель" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" styleClass="footer-bar">
            <Label fx:id="countLabel" text="Всего занятий: 0" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button onAction="#onSave" styleClass="button-primary" text="Добавить" />
            <Button onAction="#onReturnOneAutoToPool" styleClass="button-secondary" text="Вернуть в пул" />
            <Button onAction="#onReturnAllAutoToPool" styleClass="button-secondary" text="Вернуть все в пул" />
            <Button onAction="#onDelete" styleClass="button-danger" text="Удалить" />
            <Button onAction="#onDeleteAll" styleClass="button-danger" text="Удалить все" />
        </HBox>
    </bottom>

</BorderPane>
